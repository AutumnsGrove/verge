{
  "version": 1,
  "identity": "app",
  "provider": "opencode-go",
  "providerEnv": "OPENCODE_API_KEY",
  "model": "deepseek-v4.1-flash",
  "thinking": "high",
  "tools": {
    "bash": true
  },
  "verify": {
    "installDependencies": true,
    "installCommand": ""
  },
  "triggers": {
    "types": [
      "opened",
      "synchronize",
      "ready_for_review",
      "reopened"
    ],
    "skipDrafts": true,
    "skipBots": false,
    "mention": true
  },
  "review": {
    "event": "COMMENT",
    "maxInlineComments": 25,
    "strictness": "significant",
    "resolveStaleThreads": false,
    "retry": {
      "maxRetries": 6,
      "baseDelayMs": 5000,
      "maxDelayMs": 60000,
      "providerMaxRetries": 2
    },
    "onProviderFailure": "fail"
  },
  "paths": {
    "include": [],
    "exclude": []
  },
  "timeoutMinutes": 20
}
